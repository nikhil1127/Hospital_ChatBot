  "api_endpoints": {
    "webhook": "POST /whatsapp/",
    "admin_dashboard": "GET /admin",
    "add_doctor": "POST /admin/add-doctor",
    "list_appointments": "GET /admin",
    "complete_appointment": "GET /admin/appointment/{id}/complete",
    "cancel_appointment": "GET /admin/appointment/{id}/cancel",
    "soft_delete_appointment": "GET /admin/appointment/{id}/soft-delete"
  }
}
